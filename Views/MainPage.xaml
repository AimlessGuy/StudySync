<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:StudySync.ViewModels"
             xmlns:models="clr-namespace:StudySync.Models"
             x:Name="MainPageRoot"
             x:Class="StudySync.Views.MainPage"
             x:DataType="viewModels:MainViewModel"
             Title="StudySync"
             BackgroundColor="{DynamicResource Background}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16"
                                 Spacing="14">

                <Border Style="{StaticResource HeroBorderStyle}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto,Auto,Auto,Auto">
                        <Label Text="StudySync"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource Gray100}" />

                        <Border Grid.Column="1"
                                BackgroundColor="{DynamicResource AccentGlow}"
                                Padding="10,6"
                                StrokeThickness="0"
                                VerticalOptions="Start">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Label Text="{Binding NotificationsLabel}"
                                   Style="{StaticResource ChipLabel}" />
                        </Border>

                        <Label Grid.Row="1"
                               Text="{Binding AccountLabel}"
                               Margin="0,6,0,0"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource Gray200}" />

                        <Label Grid.Row="2"
                               Text="Capture class notes, clean them up, and share them with the right section."
                               Margin="0,10,0,0"
                               FontSize="14"
                               TextColor="{DynamicResource Gray300}" />

                        <HorizontalStackLayout Grid.Row="3"
                                               Spacing="10"
                                               Margin="0,18,0,0">
                            <Button Text="Manage Account"
                                    Command="{Binding GoToAccountCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="16,10" />
                            <Button Text="Open Notifications"
                                    Command="{Binding GoToNotificationsCommand}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Padding="16,10" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="12">

                    <Border Grid.Column="0"
                            MinimumHeightRequest="188"
                            Style="{StaticResource CardBorderStyle}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToCameraCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="12">
                            <Border BackgroundColor="{DynamicResource AccentGlow}"
                                    HorizontalOptions="Start"
                                    Padding="12"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <Label Text="📷"
                                       FontSize="22"
                                       TextColor="{DynamicResource Gray100}" />
                            </Border>

                            <Label Text="Camera"
                                   Style="{StaticResource SectionTitle}" />
                            <Label Text="Scan notes, stack pages, and run OCR."
                                   FontSize="13"
                                   LineBreakMode="WordWrap"
                                   TextColor="{DynamicResource Gray300}" />
                            <Label Text="Tap to capture"
                                   Margin="0,6,0,0"
                                   Style="{StaticResource MetaLabel}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
                            MinimumHeightRequest="188"
                            Style="{StaticResource CardBorderStyle}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToVaultCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="12">
                            <Border BackgroundColor="{DynamicResource AccentGlow}"
                                    HorizontalOptions="Start"
                                    Padding="12"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <Label Text="📚"
                                       FontSize="22"
                                       TextColor="{DynamicResource Gray100}" />
                            </Border>

                            <Label Text="My Vault"
                                   Style="{StaticResource SectionTitle}" />
                            <Label Text="{Binding NoteCount, StringFormat='{0} saved notes across albums and notebooks.'}"
                                   FontSize="13"
                                   LineBreakMode="WordWrap"
                                   TextColor="{DynamicResource Gray300}" />
                            <Label Text="Open notebooks and albums"
                                   Margin="0,6,0,0"
                                   Style="{StaticResource MetaLabel}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Recent Activity"
                               Style="{StaticResource SectionTitle}" />
                        <Label Text="Jump back into your latest saved notes."
                               Style="{StaticResource MetaLabel}" />
                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            BackgroundColor="{DynamicResource SurfaceMuted}"
                            Padding="10,6"
                            StrokeThickness="0"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Label Text="{Binding NoteCount, StringFormat='{0} total'}"
                               Style="{StaticResource ChipLabel}" />
                    </Border>
                </Grid>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentNotes}"
                                     Spacing="8">
                    <BindableLayout.EmptyView>
                        <Border Style="{StaticResource CardBorderStyle}"
                                Padding="26">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <VerticalStackLayout HorizontalOptions="Center"
                                                 VerticalOptions="Center"
                                                 Spacing="8">
                                <Label Text="No notes yet"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       TextColor="{DynamicResource Gray100}" />
                                <Label Text="Use the camera card above to build your first study note."
                                       HorizontalTextAlignment="Center"
                                       TextColor="{DynamicResource Gray400}" />
                            </VerticalStackLayout>
                        </Border>
                    </BindableLayout.EmptyView>

                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Note">
                            <Border Style="{StaticResource CardBorderStyle}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer x:DataType="{x:Null}"
                                                          Command="{Binding Source={x:Reference MainPageRoot}, Path=BindingContext.SelectNoteCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="Auto,Auto,Auto"
                                      ColumnDefinitions="*,Auto"
                                      RowSpacing="8">
                                    <Label Grid.Row="0"
                                           Text="{Binding CourseCode}"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           TextColor="{DynamicResource Primary}" />
                                    <Label Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding TimeDisplay}"
                                           Style="{StaticResource MetaLabel}"
                                           HorizontalOptions="End" />
                                    <Label Grid.Row="1"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding PreviewText}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2"
                                           TextColor="{DynamicResource Gray100}" />
                                    <HorizontalStackLayout Grid.Row="2"
                                                           Grid.ColumnSpan="2"
                                                           Spacing="8">
                                        <Border BackgroundColor="{DynamicResource SurfaceMuted}"
                                                Padding="10,6"
                                                StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding ContentType}"
                                                   Style="{StaticResource ChipLabel}" />
                                        </Border>
                                        <Label Text="{Binding IsShared, StringFormat='Shared: {0}'}"
                                               Style="{StaticResource MetaLabel}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1"
                Margin="0,8,0,0"
                Padding="10"
                Style="{StaticResource CardBorderStyle}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,*">
                <VerticalStackLayout Grid.Column="0"
                                     HorizontalOptions="Center"
                                     Spacing="4">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToFeedCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="Feed"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{DynamicResource Gray100}" />
                    <Label Text="All shared notes"
                           FontSize="12"
                           HorizontalOptions="Center"
                           TextColor="{DynamicResource Gray400}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1"
                                     HorizontalOptions="Center"
                                     Spacing="4">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToSectionsCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="Sections"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{DynamicResource Gray100}" />
                    <Label Text="Your joined groups"
                           FontSize="12"
                           HorizontalOptions="Center"
                           TextColor="{DynamicResource Gray400}" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
