<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:StudySync.ViewModels"
             xmlns:models="clr-namespace:StudySync.Models"
             x:Class="StudySync.Views.ResultPage"
             x:DataType="viewModels:ResultViewModel"
             Title="Extracted Text"
             BackgroundColor="{DynamicResource Background}">

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="16"
          RowSpacing="12">

        <VerticalStackLayout Grid.Row="0"
                             Spacing="12">
            <Border BackgroundColor="{DynamicResource SurfaceMuted}"
                    StrokeThickness="0"
                    HeightRequest="180">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Image x:Name="CapturedImage"
                       Aspect="AspectFit"
                       Margin="10" />
            </Border>

            <VerticalStackLayout Spacing="6"
                                 IsVisible="{Binding IsProcessing}">
                <Label Text="{Binding OcrStatus}"
                       HorizontalOptions="Center"
                       FontSize="13"
                       TextColor="{DynamicResource Primary}" />
                <ProgressBar Progress="{Binding OcrProgress}"
                             ProgressColor="{DynamicResource Primary}"
                             HeightRequest="8" />
                <Label Text="{Binding OcrProgressPercent, StringFormat='{0}%'}"
                       HorizontalOptions="Center"
                       FontSize="12"
                       TextColor="{DynamicResource Gray500}" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <Border Grid.Row="1"
                BackgroundColor="{DynamicResource Surface}"
                StrokeThickness="0"
                Padding="16">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>

            <ScrollView>
                <VerticalStackLayout Spacing="14">
                    <Label Text="Review and tag your note"
                           TextColor="{DynamicResource Primary}"
                           FontSize="18"
                           FontAttributes="Bold" />

                    <Label Text="Primary subject"
                           FontSize="14"
                           TextColor="{DynamicResource Gray900}"
                           FontAttributes="Bold" />
                    <Picker Title="Choose one subject"
                            ItemsSource="{Binding PrimarySubjectTags}"
                            SelectedItem="{Binding SelectedPrimarySubjectTag}"
                            IsEnabled="{Binding IsTextExtracted}" />

                    <Label Text="Secondary tags"
                           FontSize="14"
                           TextColor="{DynamicResource Gray900}"
                           FontAttributes="Bold" />
                    <Entry Text="{Binding SecondaryTagsInput}"
                           Placeholder="Add your own tags, separated by commas"
                           IsEnabled="{Binding IsTextExtracted}" />

                    <Label Text="Share to sections"
                           FontSize="14"
                           TextColor="{DynamicResource Gray900}"
                           FontAttributes="Bold" />

                    <CollectionView ItemsSource="{Binding JoinedSections}"
                                    SelectionMode="None"
                                    HeightRequest="170"
                                    IsVisible="{Binding HasJoinedSections}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:SelectableSection">
                                <Border BackgroundColor="{DynamicResource SurfaceMuted}"
                                        StrokeThickness="0"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto,*"
                                          ColumnSpacing="10">
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="2">
                                            <Label Text="{Binding Name}"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource Gray900}" />
                                            <Label Text="{Binding InviteCode, StringFormat='Invite code: {0}'}"
                                                   FontSize="12"
                                                   TextColor="{DynamicResource Gray500}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Text="Join a section first if you want to post this note to classmates."
                           FontSize="12"
                           TextColor="{DynamicResource Gray500}"
                           IsVisible="{Binding HasNoJoinedSections}" />

                    <Label Text="Extracted text"
                           FontSize="14"
                           TextColor="{DynamicResource Gray900}"
                           FontAttributes="Bold" />
                    <Editor Text="{Binding ExtractedText}"
                            BackgroundColor="{DynamicResource SurfaceMuted}"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="260"
                            IsEnabled="{Binding IsTextExtracted}"
                            TextColor="{DynamicResource Gray900}" />
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <VerticalStackLayout Grid.Row="2"
                             Spacing="8">
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="8"
                  IsEnabled="{Binding IsTextExtracted}">
                <Button Grid.Column="0"
                        Text="Save to Vault"
                        Command="{Binding SaveNoteCommand}"
                        BackgroundColor="{DynamicResource Primary}"
                        TextColor="White"
                        CornerRadius="8" />
                <Button Grid.Column="1"
                        Text="Share"
                        Command="{Binding ShareNoteCommand}"
                        BackgroundColor="{DynamicResource Secondary}"
                        TextColor="{DynamicResource Gray900}"
                        CornerRadius="8" />
            </Grid>

            <Button Text="Process Again"
                    Command="{Binding ProcessAgainCommand}"
                    BackgroundColor="{DynamicResource Gray600}"
                    TextColor="White"
                    CornerRadius="8"
                    IsEnabled="{Binding IsTextExtracted}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
