<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:StudySync.ViewModels"
             xmlns:models="clr-namespace:StudySync.Models"
             x:Class="StudySync.Views.ResultPage"
             x:DataType="viewModels:ResultViewModel"
             Title="Extracted Text"
             BackgroundColor="{DynamicResource Background}">

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="16"
          RowSpacing="12">

        <VerticalStackLayout Grid.Row="0"
                             Spacing="12">
            <Border BackgroundColor="{DynamicResource SurfaceMuted}"
                    StrokeThickness="0"
                    HeightRequest="180">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Image x:Name="CapturedImage"
                       Aspect="AspectFit"
                       Margin="10" />
            </Border>

            <Label Text="{Binding PageSummaryText}"
                   HorizontalOptions="Center"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource Gray700}"
                   IsVisible="{Binding HasMultiplePages}" />

            <VerticalStackLayout Spacing="6"
                                 IsVisible="{Binding IsProcessing}">
                <Label Text="{Binding OcrStatus}"
                       HorizontalOptions="Center"
                       FontSize="13"
                       TextColor="{DynamicResource Primary}" />
                <ProgressBar Progress="{Binding OcrProgress}"
                             ProgressColor="{DynamicResource Primary}"
                             HeightRequest="8" />
                <Label Text="{Binding OcrProgressPercent, StringFormat='{0}%'}"
                       HorizontalOptions="Center"
                       FontSize="12"
                       TextColor="{DynamicResource Gray500}" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <Border Grid.Row="1"
                BackgroundColor="{DynamicResource Surface}"
                StrokeThickness="0"
                Padding="16">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>

            <ScrollView>
                <VerticalStackLayout Spacing="14">
                    <Label Text="Review and tag your note"
                           TextColor="{DynamicResource Primary}"
                           FontSize="18"
                           FontAttributes="Bold" />

                    <Border BackgroundColor="#FEF3C7"
                            StrokeThickness="0"
                            Padding="12"
                            IsVisible="{Binding HasOcrWarning}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Label Text="{Binding OcrWarning}"
                               FontSize="12"
                               TextColor="#92400E" />
                    </Border>

                    <Border BackgroundColor="{Binding OcrConfidenceBackgroundColor}"
                            StrokeThickness="0"
                            Padding="12"
                            IsVisible="{Binding HasOcrConfidence}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding OcrConfidenceLabel}"
                                       FontAttributes="Bold"
                                       TextColor="{Binding OcrConfidenceAccentColor}" />
                                <Label Grid.Column="1"
                                       Text="{Binding OcrConfidencePercent}"
                                       FontAttributes="Bold"
                                       TextColor="{Binding OcrConfidenceAccentColor}" />
                            </Grid>
                            <Label Text="{Binding OcrConfidenceSummary}"
                                   FontSize="12"
                                   TextColor="{Binding OcrConfidenceAccentColor}" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Send to section"
                           FontSize="14"
                           TextColor="{DynamicResource Gray900}"
                           FontAttributes="Bold" />
                    <Picker Title="Choose a section first"
                            ItemsSource="{Binding JoinedSections}"
                            SelectedItem="{Binding SelectedSection}"
                            ItemDisplayBinding="{Binding Name}"
                            IsEnabled="{Binding IsTextExtracted}"
                            IsVisible="{Binding HasJoinedSections}" />

                    <Label Text="Join a section first if you want to post this note to classmates."
                           FontSize="12"
                           TextColor="{DynamicResource Gray500}"
                           IsVisible="{Binding HasNoJoinedSections}" />

                    <Label Text="Note title"
                           FontSize="14"
                           TextColor="{DynamicResource Gray900}"
                           FontAttributes="Bold" />
                    <Entry Text="{Binding NoteTitle}"
                           Placeholder="Give this note a title"
                           IsEnabled="{Binding IsTextExtracted}" />

                    <Label Text="Primary tag"
                           FontSize="14"
                           TextColor="{DynamicResource Gray900}"
                           FontAttributes="Bold" />
                    <Picker Title="Choose an existing primary tag from this section"
                            ItemsSource="{Binding PrimarySubjectTags}"
                            SelectedItem="{Binding SelectedPrimarySubjectTag}"
                            IsEnabled="{Binding IsTextExtracted}"
                            IsVisible="{Binding HasSuggestedPrimaryTags}" />

                    <Entry Text="{Binding PrimarySubjectTagInput}"
                           Placeholder="Or create a new primary tag"
                           IsEnabled="{Binding IsTextExtracted}" />

                    <Label Text="Suggested primary tags now reflect only the section you chose above. You can still type a new one if needed."
                           FontSize="12"
                           TextColor="{DynamicResource Gray500}" />

                    <Label Text="Secondary tags"
                           FontSize="14"
                           TextColor="{DynamicResource Gray900}"
                           FontAttributes="Bold" />
                    <Entry Text="{Binding SecondaryTagsInput}"
                           Placeholder="Add your own tags, separated by commas"
                           IsEnabled="{Binding IsTextExtracted}" />

                    <Label Text="Extracted text"
                           FontSize="14"
                           TextColor="{DynamicResource Gray900}"
                           FontAttributes="Bold" />
                    <Editor Text="{Binding ExtractedText}"
                            BackgroundColor="{DynamicResource SurfaceMuted}"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="260"
                            IsEnabled="{Binding IsTextExtracted}"
                            TextColor="{DynamicResource Gray900}" />
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <VerticalStackLayout Grid.Row="2"
                             Spacing="8">
            <Button Text="Share to Section"
                    Command="{Binding ShareNoteCommand}"
                    BackgroundColor="{DynamicResource Primary}"
                    TextColor="White"
                    CornerRadius="8"
                    IsEnabled="{Binding IsTextExtracted}" />

            <Button Text="Process Again"
                    Command="{Binding ProcessAgainCommand}"
                    BackgroundColor="{DynamicResource Gray600}"
                    TextColor="White"
                    CornerRadius="8"
                    IsEnabled="{Binding IsTextExtracted}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
