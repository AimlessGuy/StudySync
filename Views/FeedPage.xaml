<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:StudySync.ViewModels"
             xmlns:models="clr-namespace:StudySync.Models"
             x:Class="StudySync.Views.FeedPage"
             x:DataType="viewModels:FeedViewModel"
             Title="📱 Class Feed"
             BackgroundColor="{DynamicResource Background}">

    <Grid RowDefinitions="Auto, *" Padding="16" RowSpacing="12">

        <!-- Header -->
        <Border Grid.Row="0"
                BackgroundColor="{DynamicResource Primary}"
                StrokeThickness="0"
                Padding="16">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="4">
                <Label Text="📱 Class Feed"
                       TextColor="White"
                       FontSize="20"
                       FontAttributes="Bold" />
                <Label Text="{Binding SharedCount, StringFormat='{0} notes shared by classmates'}"
                       TextColor="White"
                       FontSize="13" />
            </VerticalStackLayout>
        </Border>

        <!-- Shared Notes List -->
        <CollectionView x:Name="FeedCollection"
                        Grid.Row="1"
                        ItemsSource="{Binding SharedNotes}"
                        Margin="0,8,0,0">

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="12">
                    <Label Text="📭"
                           FontSize="48"
                           HorizontalOptions="Center" />
                    <Label Text="No shared notes yet"
                           FontSize="16"
                           HorizontalOptions="Center" />
                    <Label Text="Be the first to share from the camera!"
                           TextColor="{DynamicResource Gray500}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Note">
                    <Border Margin="0,0,0,10"
                            Padding="16"
                            BackgroundColor="{DynamicResource White}"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Grid RowDefinitions="Auto, Auto, Auto"
                              ColumnDefinitions="*, Auto"
                              RowSpacing="6">

                            <!-- Course + Time -->
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding CourseCode}"
                                   TextColor="{DynamicResource Primary}"
                                   FontAttributes="Bold"
                                   FontSize="16" />
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding TimeDisplay}"
                                   TextColor="{DynamicResource Gray500}"
                                   FontSize="12"
                                   HorizontalOptions="End" />

                            <!-- Preview Text -->
                            <Label Grid.Row="1" Grid.ColumnSpan="2"
                                   Text="{Binding PreviewText}"
                                   MaxLines="3"
                                   LineBreakMode="TailTruncation"
                                   FontSize="14" />

                            <!-- Content type + Anonymous badge -->
                            <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Spacing="8">
                                <Label Text="{Binding ContentType}"
           TextColor="{DynamicResource Gray600}"
           FontSize="12" />
                                <Label Text="🕵️ Anonymous"
           TextColor="{DynamicResource Gray500}"
           FontSize="12"
           IsVisible="{Binding IsAnonymous}" />
                            </HorizontalStackLayout>

                            <Button Grid.Row="2" Grid.Column="1"
        Text="{Binding Upvotes, StringFormat='👍 {0}'}"
        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:FeedViewModel}}, Path=UpvoteNoteCommand}"
        CommandParameter="{Binding .}"
        BackgroundColor="Transparent"
        TextColor="{DynamicResource Primary}"
        FontSize="13"
        Padding="0"
        HorizontalOptions="End" />
                            

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>