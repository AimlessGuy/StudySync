<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:StudySync.ViewModels"
             xmlns:models="clr-namespace:StudySync.Models"
             x:Class="StudySync.Views.NotificationsPage"
             x:Name="NotificationsPageRoot"
             x:DataType="viewModels:NotificationsViewModel"
             Title="Notifications"
             BackgroundColor="{DynamicResource Background}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <models:BoolToUnreadTextConverter x:Key="BoolToUnreadTextConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*"
          Padding="16"
          RowSpacing="12">
        <Border Grid.Row="0"
                BackgroundColor="{DynamicResource Surface}"
                StrokeThickness="0"
                Padding="16">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Notifications"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource Gray900}" />
                    <Label Text="{Binding UnreadCount, StringFormat='{0} unread'}"
                           FontSize="13"
                           TextColor="{DynamicResource Gray500}" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="Mark All Read"
                        Command="{Binding MarkAllReadCommand}"
                        BackgroundColor="{DynamicResource Secondary}"
                        TextColor="{DynamicResource Gray900}"
                        Padding="14,8" />
            </Grid>
        </Border>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Notifications}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="16"
                                     Spacing="8"
                                     VerticalOptions="Center">
                    <Label Text="No notifications yet"
                           FontSize="16"
                           TextColor="{DynamicResource Gray900}"
                           HorizontalOptions="Center" />
                    <Label Text="Peer alerts will show up here as your sections get active."
                           TextColor="{DynamicResource Gray500}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:AppNotification">
                    <Border Margin="0,0,0,10"
                            BackgroundColor="{DynamicResource Surface}"
                            StrokeThickness="0"
                            Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer x:DataType="{x:Null}"
                                                  Command="{Binding Source={x:Reference NotificationsPageRoot}, Path=BindingContext.OpenNotificationCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0"
                                                 Spacing="4">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding Title}"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource Gray900}" />
                                    <Label Text="{Binding IsRead, Converter={StaticResource BoolToUnreadTextConverter}}"
                                           FontSize="12"
                                           TextColor="{DynamicResource Primary}"
                                           FontAttributes="Bold" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Message}"
                                       TextColor="{DynamicResource Gray600}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="{Binding TimeDisplay}"
                                   TextColor="{DynamicResource Gray500}"
                                   FontSize="12"
                                   VerticalOptions="Start" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
