<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:StudySync.ViewModels"
             x:Class="StudySync.Views.NoteDetailPage"
             x:DataType="viewModels:NoteDetailViewModel"
             Title="{Binding NoteTitle}"
             BackgroundColor="{DynamicResource Background}">

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="16"
          RowSpacing="12">

        <Border Grid.Row="0"
                BackgroundColor="{DynamicResource Surface}"
                StrokeThickness="0"
                Padding="16">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="8">
                <Editor Text="{Binding NoteTitle}"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource Primary}"
                        BackgroundColor="Transparent"
                        AutoSize="TextChanges"
                        Placeholder="Enter title..." />

                <HorizontalStackLayout Spacing="12">
                    <Label Text="{Binding CourseCode}"
                           FontSize="14"
                           TextColor="{DynamicResource Gray600}" />
                    <Label Text="•"
                           TextColor="{DynamicResource Gray600}" />
                    <Label Text="{Binding ContentType}"
                           FontSize="14"
                           TextColor="{DynamicResource Gray600}" />
                    <Label Text="•"
                           TextColor="{DynamicResource Gray600}" />
                    <Label Text="{Binding UpdatedDate, StringFormat='Updated: {0}'}"
                           FontSize="14"
                           TextColor="{DynamicResource Gray600}" />
                    <Label Text="{Binding CreatedDate}"
                           IsVisible="False" />
                </HorizontalStackLayout>

                <Label Text="Extracted Text"
                       TextColor="{DynamicResource Gray900}"
                       FontSize="16"
                       FontAttributes="Bold"
                       Margin="0,8,0,0" />
            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="2"
                BackgroundColor="{DynamicResource Surface}"
                StrokeThickness="0"
                Padding="16">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto,*,Auto"
                  RowSpacing="12">

                <Label Grid.Row="0"
                       Text="Extracted text - tap to edit"
                       FontSize="13"
                       TextColor="{DynamicResource Gray500}" />

                <Editor Grid.Row="1"
                        Text="{Binding NoteText}"
                        FontSize="14"
                        TextColor="{DynamicResource Gray900}"
                        BackgroundColor="{DynamicResource SurfaceMuted}"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="200" />

                <Grid Grid.Row="2"
                      ColumnDefinitions="*,*,*"
                      ColumnSpacing="8">
                    <Button Grid.Column="0"
                            Text="Save"
                            Command="{Binding SaveChangesCommand}"
                            BackgroundColor="{DynamicResource Primary}"
                            TextColor="White"
                            CornerRadius="8" />

                    <Button Grid.Column="1"
                            Text="Share"
                            Command="{Binding ShareNoteCommand}"
                            BackgroundColor="{DynamicResource Secondary}"
                            TextColor="{DynamicResource Gray900}"
                            CornerRadius="8" />

                    <Button Grid.Column="2"
                            Text="Delete"
                            Command="{Binding DeleteNoteCommand}"
                            BackgroundColor="{DynamicResource Danger}"
                            TextColor="White"
                            CornerRadius="8" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
